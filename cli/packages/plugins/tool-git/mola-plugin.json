{
  "schemaVersion": 1,
  "id": "mola-tool-git",
  "version": "0.1.0",
  "kind": "tool",
  "displayName": "mola tool git + gh (worktrees, PRs)",
  "mola": ">=0.1.0 <1.0.0",
  "engine": {
    "node": ">=22"
  },
  "entry": {
    "ts": "./dist/index.js"
  },
  "provides": ["tool:git", "tool:gh", "tool:git.worktree"],
  "requires": [],
  "capabilities": ["tool.git", "tool.gh", "tool.git.worktree"],
  "permissions": {
    "process.exec": ["git", "git.exe", "gh", "gh.exe"],
    "mola": ["doctor", "tools.register"]
  },
  "hooks": {
    "emit": [],
    "listen": []
  }
}
