{
  "schemaVersion": 1,
  "id": "mola-cmd-run",
  "version": "0.1.0",
  "kind": "command",
  "displayName": "cmd-run — mola run (the routing engine) + the mstack skill commands",
  "mola": ">=0.1.0 <1.0.0",
  "engine": {
    "node": ">=22"
  },
  "entry": {
