{
  "schemaVersion": 1,
  "id": "mola-cmd-dispatch",
  "version": "0.1.0",
  "kind": "command",
  "displayName": "mola dispatch <task-file|-> — DSH headless worker (WSL, profile mola-cli)",
  "mola": ">=0.1.0 <1.0.0",
  "engine": {
    "node": ">=22"
  },
  "entry": {
    "ts": "./dist/index.js"
  },
  "provides": ["cmd:dispatch"],
  "requires": ["agent:dsh"],
  "capabilities": ["command.dispatch"],
  "permissions": {
    "process.exec": ["bash", "wsl"],
    "fs.read": ["**"],
    "fs.write": ["**/logs/**", "**/.mstack/runs/**"],
    "mola": ["events", "commands", "config.read", "state.kv"]
  },
  "hooks": {
    "emit": [
      "mola.session.started",
      "mola.session.ended",
      "mola.tool.after",
      "mola.task.done",
      "mola.error.raised"
    ],
    "listen": []
  }
}
