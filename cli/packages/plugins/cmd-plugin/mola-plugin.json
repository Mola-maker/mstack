{
  "schemaVersion": 1,
  "id": "mola-cmd-plugin",
  "version": "0.1.0",
  "kind": "command",
  "displayName": "mola plugin list|validate|install|update|remove|enable|disable|doctor",
  "mola": ">=0.1.0 <1.0.0",
  "engine": { "node": ">=22" },
  "entry": { "ts": "./dist/index.js" },
  "provides": ["cmd:plugin"],
  "requires": [],
  "capabilities": ["command.plugin"],
  "permissions": {
    "process.exec": ["pnpm", "cmd"],
    "fs.read": ["**"],
    "fs.write": ["**"],
    "mola": ["events", "commands", "config.read", "state.kv", "doctor"]
  },
  "hooks": {
    "emit": [],
    "listen": []
  }
}
