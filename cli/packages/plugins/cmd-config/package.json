{
  "name": "@mola/plugin-cmd-config",
  "version": "0.1.0",
  "description": "mola builtin plugin: `mola config get|set` (B1 minimal surface)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "mola-plugin.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@mola/plugin-sdk": "workspace:*"
  }
}
