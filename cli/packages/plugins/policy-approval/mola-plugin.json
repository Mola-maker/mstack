{
  "schemaVersion": 1,
  "id": "mola-policy-approval",
  "version": "0.1.0",
  "kind": "policy",
  "displayName": "route whitelist + conservative approval classifier (gates)",
  "mola": ">=0.1.0 <1.0.0",
  "engine": {
    "node": ">=22"
  },
  "entry": {
    "ts": "./dist/index.js"
  },
  "provides": ["policy:route-whitelist", "policy:approval-classifier"],
  "requires": [],
  "capabilities": ["policy.route-whitelist", "policy.approval-classifier"],
  "permissions": {
    "mola": ["events", "config.read", "state.kv"]
  },
  "hooks": {
    "emit": ["mola.approval.granted", "mola.approval.denied"],
    "listen": ["mola.tool.before", "mola.task.pre-dispatch"]
  }
}
