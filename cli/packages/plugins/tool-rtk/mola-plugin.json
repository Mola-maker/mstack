    "process.exec": ["rtk", "rtk.exe"],
    "env.read": ["LOCALAPPDATA", "PATH", "PATHEXT", "XDG_DATA_HOME"],
    "mola": ["doctor", "tools.register"]
  },
  "hooks": {
    "emit": [],
    "listen": []
  }
}
