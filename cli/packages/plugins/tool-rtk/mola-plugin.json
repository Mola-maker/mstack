{
  "schemaVersion": 1,
  "id": "mola-tool-rtk",
  "version": "0.1.0",
  "kind": "tool",
  "displayName": "mola tool rtk (output compaction)",
  "mola": ">=0.1.0 <1.0.0",
  "engine": {
    "node": ">=22"
  },
  "entry": {
    "ts": "./dist/index.js"
  },
  "provides": ["tool:rtk"],
  "requires": [],
