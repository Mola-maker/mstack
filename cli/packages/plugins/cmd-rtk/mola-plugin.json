{
  "schemaVersion": 1,
  "id": "mola-cmd-rtk",
  "version": "0.1.0",
  "kind": "command",
  "displayName": "mola rtk (verbatim passthrough)",
  "mola": ">=0.1.0 <1.0.0",
  "engine": {
    "node": ">=22"
  },
  "entry": {
    "ts": "./dist/index.js"
  },
  "provides": ["cmd:rtk"],
  "requires": [],
  "capabilities": ["command.rtk"],
  "permissions": {
    "process.exec": ["rtk", "rtk.exe"],
    "env.read": ["LOCALAPPDATA", "PATH", "PATHEXT"],
    "mola": ["commands"]
  },
  "hooks": {
    "emit": [],
    "listen": []
  }
}
