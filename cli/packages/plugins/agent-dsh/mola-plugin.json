{
  "schemaVersion": 1,
  "id": "mola-agent-dsh",
  "version": "0.1.0",
  "kind": "agent",
  "displayName": "DSH (DeepSeek Harness) — WSL headless adapter, profile mola-cli",
  "mola": ">=0.1.0 <1.0.0",
  "engine": {
    "node": ">=22"
  },
  "entry": {
    "ts": "./dist/index.js"
  },
  "provides": ["agent:dsh"],
  "requires": [],
  "capabilities": [
    "headless",
    "headless-json-stream",
    "resume",
    "native-hooks",
    "acp"
  ],
  "permissions": {
    "process.exec": ["bash", "wsl", "dsh"],
    "fs.write": ["**/.mstack/runs/**"],
    "mola": ["doctor", "agents.register", "events"]
  },
  "hooks": {
    "emit": [
      "mola.session.started",
      "mola.agent.message",
      "mola.turn.completed",
      "mola.task.done",
      "mola.error.raised",
      "mola.session.ended"
    ],
    "listen": []
  }
}
