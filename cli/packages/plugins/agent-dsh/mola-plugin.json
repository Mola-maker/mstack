{
  "schemaVersion": 1,
  "id": "mola-agent-dsh",
  "version": "0.1.0",
  "kind": "agent",
  "displayName": "DSH (DeepSeek Harness) — WSL headless adapter, profile mola-cli",
  "mola": ">=0.1.0 <1.0.0",
  "engine": {
    "node": ">=22"
  },
  "entry": {
    "ts": "./dist/index.js"
  },
  "provides": ["agent:dsh"],
  "requires": [],
  "capabilities": [
    "headless",
    "headless-json-stream",
    "resume",
    "native-hooks"
  ],
  "permissions": {
    "process.exec": ["bash", "wsl", "dsh"],
    "mola": ["doctor", "agents.register"]
  },
  "hooks": {
    "emit": [],
    "listen": []
  }
}
