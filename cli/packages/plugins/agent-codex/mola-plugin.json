{
  "schemaVersion": 1,
  "id": "mola-agent-codex",
  "version": "0.1.0",
  "kind": "agent",
  "displayName": "agent-codex — Codex CLI headless adapter (exec, probe-gated --json/resume)",
  "mola": ">=0.1.0 <1.0.0",
  "engine": {
    "node": ">=22"
  },
  "entry": {
    "ts": "./dist/index.js"
  },
  "provides": ["agent:codex"],
  "requires": [],
  "capabilities": [
    "headless",
    "list-sessions"
  ],
  "permissions": {
    "process.exec": ["codex", "cmd", "magpie"],
    "mola": ["agents.register", "events"]
  },
  "hooks": {
    "emit": [
      "mola.session.started",
      "mola.agent.message",
      "mola.turn.completed",
      "mola.task.done",
      "mola.error.raised",
      "mola.session.ended"
    ],
    "listen": []
  }
}
