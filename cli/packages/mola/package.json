{
  "name": "mola",
  "version": "0.1.0",
  "description": "mola — plugin-based agent orchestration CLI (B1 skeleton)",
  "type": "module",
  "bin": {
    "mola": "./dist/bin.js"
  },
  "main": "./dist/bin.js",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && tsc -b tsconfig.test.json",
    "test": "node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@mola/core": "workspace:*",
    "@mola/plugin-sdk": "workspace:*",
    "@mola/plugin-cmd-doctor": "workspace:*",
    "@mola/plugin-cmd-config": "workspace:*",
    "@mola/plugin-cmd-plugin": "workspace:*",
    "@mola/plugin-cmd-dispatch": "workspace:*",
    "@mola/plugin-agent-dsh": "workspace:*",
    "@mola/plugin-policy-approval": "workspace:*",
    "@mola/plugin-cmd-model": "workspace:*",
    "@mola/plugin-tool-magpie": "workspace:*",
    "@mola/plugin-cmd-rtk": "workspace:*",
    "@mola/plugin-tool-rtk": "workspace:*",
    "@mola/plugin-tool-git": "workspace:*"
  }
}
